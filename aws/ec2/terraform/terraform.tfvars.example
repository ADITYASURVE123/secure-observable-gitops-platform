allowed_ssh_cidr = "203.0.113.10/32"                   # your IP: curl -s https://checkip.amazonaws.com  (append /32)
ssh_public_key   = "ssh-ed25519 AAAA... gitops-aws"    # cat ~/.ssh/gitops-aws.pub
