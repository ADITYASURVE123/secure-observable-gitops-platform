# Copy to ci/.env (done by ./ci/scripts/init-env.sh). ci/.env is git-ignored. NEVER commit tokens.

# Generated automatically by init-env.sh
JENKINS_ADMIN_PASSWORD=
JENKINS_URL=http://localhost:8081/

# --- Container registry (default: GitHub Container Registry) ---
REGISTRY=ghcr.io
REGISTRY_NAMESPACE=adityasurve123
REGISTRY_USER=ADITYASURVE123
# GHCR: classic PAT with write:packages. Docker Hub: access token with Read & Write.
REGISTRY_TOKEN=
# Docker Hub instead? use:  REGISTRY=docker.io  REGISTRY_NAMESPACE=adityasurve  REGISTRY_USER=adityasurve

# --- Git repository the pipeline reads and writes manifests to ---
GIT_REPO_URL=https://github.com/ADITYASURVE123/secure-observable-gitops-platform.git
MANIFEST_BRANCH=main
GIT_USER=ADITYASURVE123
# Fine-grained PAT, only this repo, permission: Contents = Read and write
GIT_TOKEN=
